{
  "name": "hearthlight",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:unit": "vitest --run",
    "test:balance": "node scripts/campaign-balance.js --assert",
    "balance:story": "node scripts/campaign-balance.js --story",
    "balance:baseline": "node scripts/campaign-balance.js --json > scripts/balance-baseline.json",
    "balance:compare": "node scripts/campaign-balance.js --compare scripts/balance-baseline.json",
    "test:quality": "npm run lint && npm run test:unit && npm run test:balance && npm run test:strategies && npm run build",
    "test:smoke": "npm run build && node scripts/browser-smoke.mjs",
    "perf:probe": "npm run build && node scripts/perf-probe.mjs",
    "render:scenes": "node scripts/render-scenes.mjs",
    "test:strategies": "node scripts/build-strategies.js"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.3.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
